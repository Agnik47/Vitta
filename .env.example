# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# All values below must come from a Dodo Payments TEST MODE account. See docs/02-DODO-INTEGRATION.md.

# Write key: used by fund(), draw(), release() in src/ledger/DodoCreditLedger.ts
DODO_API_KEY=sk_test_xxxxx

# Read-only key: used by balance(), and by the dashboard's API routes (never the write key)
DODO_API_KEY_READONLY=sk_test_ro_xxxxx

# Always "test" in this project. Live mode is out of scope — see CLAUDE.md Hard rule 1.
DODO_ENV=test

# Standard Webhooks signing secret, from the Dodo dashboard's webhook settings
DODO_WEBHOOK_SECRET=whsec_xxxxx

# The one-time "Agent Spend Credits" Credit Entitlement's own id (cde_...), created once per
# docs/02-DODO-INTEGRATION.md's setup step 4. Needed by balance()/draw() and the dashboard's
# balance read — the real SDK's balance/deduct methods are keyed by (customer_id, credit_entitlement_id),
# not by checkout-session id; see docs/OUTCOME.md's "Running list of open questions resolved"
# for the real SDK shape this was found against. Not in the original spec's env list.
DODO_CREDIT_ENTITLEMENT_ID=cde_xxxxx
