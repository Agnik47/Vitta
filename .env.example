# Copy to .env and load it into the shell before running gate commands (or use `node --env-file=.env`).
# Never commit real keys — .env is gitignored, this file is not.

# ---- Razorpay TEST mode (the reserve rail) ----------------------------------------------------
# Dashboard → Account & Settings → API Keys, with the dashboard switched to TEST mode.
# A live key (rzp_live_…) is refused: Vitta only runs against Razorpay test mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Optional — only for the dashboard's /api/razorpay/webhook (order.paid / payment.captured). This is the
# secret set in Razorpay's webhook settings, NOT the API secret. Razorpay blocks ngrok-style tunnels;
# their docs recommend zrok for local testing.
# RAZORPAY_WEBHOOK_SECRET=
# Where `gate fund` sends the human to pay the order (the dashboard's hosted Checkout page).
# RAZORPAY_CHECKOUT_BASE_URL=http://localhost:3000
# Test/sandbox override for the API host (the sandbox mock uses this). Leave unset for real test mode.
# RAZORPAY_API_BASE_URL=https://api.razorpay.com
# Where the ledger's append-only draw log lives (default ./razorpay-ledger.jsonl next to the mandates).
# RAZORPAY_LEDGER_PATH=./razorpay-ledger.jsonl

# ---- Multi-agent shopping (Nasiko) — all optional; see nasiko/README.md -----------------------
# Route every agent hop through a Nasiko control plane. Unset = call the agents directly.
# NASIKO_URL=          # the control-plane URL `nasiko up` prints
# NASIKO_TOKEN=            # bearer token from `nasiko auth login`; server-side only, never sent to the browser
# NASIKO_AGENT_ID_PLANNER=     # each agent's id: nasiko deploy writes it to .nasiko/agent.json
# NASIKO_AGENT_ID_DISCOVERY=
# NASIKO_AGENT_ID_EVALUATOR=
# NASIKO_AGENT_ID_PURCHASE=    # leave unset + set VITTA_AGENT_PURCHASE_URL to keep the Purchase Agent direct
# VITTA_AGENT_PURCHASE_URL=http://127.0.0.1:9104
# Where the Deal Discovery agent searches: the dashboard's /api/shop/search (Anakin first, webcmd
# fallback). Unset = straight to the read-only webcmd search.
# VITTA_DASHBOARD_URL=http://localhost:3000
# Dashboard-started runs: "a2a" = separate agent servers (`npm run agents`) instead of in-process.
# VITTA_AGENT_TRANSPORT=a2a
# Route Price Sniper fires through Discovery → Evaluator → Purchase Agent → gate (default: direct).
# VITTA_AGENT_PIPELINE=on
# Optional shared secret an agent server requires as `Authorization: Bearer <token>`.
# VITTA_AGENT_TOKEN=
# NOTE: agents never read RAZORPAY_* — only the gate CLI (and the dashboard's server routes) do.
# Do not add payment credentials to any agent.
