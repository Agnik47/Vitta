# Copy to .env and load it into the shell before running gate commands.
# Prava sandbox keys come from dashboard.prava.space. Never commit real keys.
PRAVA_SECRET_KEY=sk_test_xxxxx
# Required by Prava's merchant session API; this is the mandate owner's email.
PRAVA_USER_EMAIL=owner@example.com
# Optional override. Sandbox is the safe default.
PRAVA_API_BASE_URL=https://sandbox.api.prava.space
