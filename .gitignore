# Dependencies
node_modules/

# Locally downloaded CLI binaries (e.g. the standalone Dodo CLI) — per-machine tooling, not source.
/.bin/

# Build output
dist/

# Secrets — never commit. Covers every .env* variant (.env, .env.local, .env.production, etc.),
# not just the exact ".env" — a real credentials file named ".env.local" showed up untracked and
# would NOT have matched the old exact-match-only pattern. Fixed 2026-07-29, see docs/OUTCOME.md.
.env
.env.*
!.env.example

# Runtime data — created by the app at runtime, not hand-authored (see CLAUDE.md § Where things live).
# Gitignored deliberately: these are per-machine demo state (mandate IDs, timestamps, local ledger
# entries) that would just create merge noise between the two agents' local runs. Each agent generates
# their own locally; the two only need to line up for the joint Phase 5 rehearsal, run on one machine.
/mandates/
/receipts/
/authorizations/
/events.jsonl
/ledger.jsonl
/dashboard/purchase_jobs_store.json
/dashboard/sniper_watches_store.json

# manifest.json is deliberately NOT gitignored, unlike the runtime data above — see
# docs/OUTCOME.md Phase 1f. It's a relatively stable cache of external reference data (webcmd's
# real command list), not per-run demo state, and Agent A's machine has no webcmd install (that's
# Agent B's territory by design per docs/common/05-PHASE-OWNERSHIP.md) — without committing this,
# `gate scan` can never be tested against real data on Agent A's side at all.

# Ed25519 keypairs (issuer + gate), auto-generated on first CLI use by src/cli/keys.ts.
# Private keys must never be committed, full stop — and per-machine, same reasoning as above.
/keys/

# Editor/OS cruft
.DS_Store
Thumbs.db

.env
