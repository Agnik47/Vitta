# Copy to .env.local. Server-side only — none of these values is ever sent to the browser except the
# PUBLIC key id, which Razorpay Checkout needs.
MANDATE_GATE_DATA_DIR=../

# Razorpay TEST-mode keys (Dashboard → Account & Settings → API Keys, in Test Mode). A live key
# (rzp_live_…) is refused: Vitta only runs against Razorpay test mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Optional — enables /api/razorpay/webhook (order.paid / payment.captured / payment.authorized).
# Set in the Razorpay dashboard's webhook settings; it is NOT the API secret. Local testing needs a
# public tunnel (Razorpay blocks ngrok-style hosts; their docs recommend zrok).
RAZORPAY_WEBHOOK_SECRET=
