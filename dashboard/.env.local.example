# Copy to .env.local (gitignored by create-next-app's default .gitignore, `.env*`).

# Path to the project root the CLI writes mandates/, receipts/, events.jsonl to, relative to
# this app's cwd when running `npm run build && npm run start` from inside dashboard/.
MANDATE_GATE_DATA_DIR=../

# Read-only key ONLY — this app must never see DODO_API_KEY (the write key).
DODO_API_KEY_READONLY=sk_test_ro_xxxxx

# The one-time "Agent Spend Credits" Credit Entitlement id (cde_...) — see root .env.example
# and docs/OUTCOME.md's "Running list of open questions resolved" for why this is needed.
DODO_CREDIT_ENTITLEMENT_ID=cde_xxxxx
